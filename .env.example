# SafeZone environment variables
# Copy this file to .env and adjust as needed.

# Flask secret key (change in production!)
SECRET_KEY=safezone-dev-secret-change-me
WTF_CSRF_SECRET_KEY=safezone-csrf-dev-change-me

# Database: SQLite by default (runs out of the box).
# To use MySQL per the PRD, uncomment and set a MySQL URI, then install
# mysql-connector-python:
# DATABASE_URL=mysql+connector://safezone:password@localhost/safezone_db

# External services
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT=15

# Map tiles (OpenStreetMap)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Defaults
DEFAULT_RADIUS_KM=10
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946

SESSION_LIFETIME=3600
